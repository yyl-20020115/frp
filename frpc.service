[Unit]
Description=FRP Client
#Requires=network.target
After=network-online.target
Wants=network.target

[Service]
Type=simple
User=yilin
Group=yilin
WorkingDirectory=/usr/local/bin
ExecStart=/usr/local/bin/frpc -c /etc/frp/frpc.toml
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
